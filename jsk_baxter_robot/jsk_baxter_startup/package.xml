<?xml version="1.0"?>
<package format="3">
  <name>jsk_baxter_startup</name>
  <version>1.1.0</version>
  <description>The jsk_baxter_startup package</description>
  <maintainer email="inagaki@jsk.imi.i.u-tokyo.ac.jp">Yuto Inagaki</maintainer>
  <license>BSD</license>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <depend condition="$ROS_VERSION == 1">baxter_core_msgs</depend>
  <depend condition="$ROS_VERSION == 1">baxter_examples</depend>
  <depend condition="$ROS_VERSION == 1">baxter_description</depend>
  <depend condition="$ROS_VERSION == 1">baxter_interface</depend>
  <depend condition="$ROS_VERSION == 1">baxter_tools</depend>
  <depend condition="$ROS_VERSION == 1">checkerboard_detector</depend>
  <depend condition="$ROS_VERSION == 1">dynamic_tf_publisher</depend>
  <depend condition="$ROS_VERSION == 1">image_view</depend>
  <depend condition="$ROS_VERSION == 1">joy</depend>
  <depend condition="$ROS_VERSION == 1">openni_launch</depend>
  <depend condition="$ROS_VERSION == 1">roseus</depend>
  <depend condition="$ROS_VERSION == 1">rostwitter</depend>
  <depend condition="$ROS_VERSION == 1">sound_play</depend>
  <depend condition="$ROS_VERSION == 1">topic_tools</depend>

  <build_export_depend condition="$ROS_VERSION == 1">image_transport</build_export_depend>
  <exec_depend condition="$ROS_VERSION == 1">image_transport</exec_depend>
  <build_export_depend condition="$ROS_VERSION == 1">jsk_interactive_marker</build_export_depend>
  <exec_depend condition="$ROS_VERSION == 1">jsk_interactive_marker</exec_depend>
  <build_export_depend condition="$ROS_VERSION == 1">jsk_pcl_ros</build_export_depend>
  <exec_depend condition="$ROS_VERSION == 1">jsk_pcl_ros</exec_depend>
  <build_export_depend condition="$ROS_VERSION == 1">libuvc_camera</build_export_depend>
  <exec_depend condition="$ROS_VERSION == 1">libuvc_camera</exec_depend>
  <build_export_depend condition="$ROS_VERSION == 1">realsense2_camera</build_export_depend>
  <exec_depend condition="$ROS_VERSION == 1">realsense2_camera</exec_depend>
  <build_export_depend condition="$ROS_VERSION == 1">respeaker_ros</build_export_depend>
  <exec_depend condition="$ROS_VERSION == 1">respeaker_ros</exec_depend>
  <build_export_depend condition="$ROS_VERSION == 1">softhand_ros</build_export_depend>
  <exec_depend condition="$ROS_VERSION == 1">softhand_ros</exec_depend>
  <build_export_depend condition="$ROS_VERSION == 1">tf</build_export_depend>
  <exec_depend condition="$ROS_VERSION == 1">tf</exec_depend>
  <build_export_depend condition="$ROS_VERSION == 1">video_stream_opencv</build_export_depend>
  <exec_depend condition="$ROS_VERSION == 1">video_stream_opencv</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rospy</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">geometry_msgs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">sensor_msgs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">std_msgs</exec_depend>

  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <exec_depend condition="$ROS_VERSION == 2">launch</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_ros</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_xml</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">ros1_bridge</exec_depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
